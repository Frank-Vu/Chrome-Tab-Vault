{
  "manifest_version": 3,
  "name": "Chrome Tab Vault",
  "version": "1.0.0",
  "description": "Export and restore Chromium tabs locally, including tab groups, order, pinned state, and window layout.",
  "permissions": [
    "tabs",
    "tabGroups"
  ],
  "incognito": "split",
  "action": {
    "default_title": "Chrome Tab Vault",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}